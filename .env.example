# Super 플래너 서버 환경변수
# 실제 값을 .env.local (로컬) 또는 .env (서버)에 설정

# 로그인 아이디
APP_USERNAME=admin

# 비밀번호 해시 (argon2id)
# 생성: node scripts/hash-password.mjs <your-password>
APP_PASSWORD_HASH=

# 세션 암호화 키 (최소 32자 이상의 hex)
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# SQLite 파일 경로 (없으면 ./data/binder.sqlite 사용)
DB_PATH=./data/binder.sqlite

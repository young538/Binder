# Super 플래너 서버 환경변수
# 실제 값을 .env.local (로컬) 또는 .env (서버)에 설정

# 로그인 아이디
APP_USERNAME=admin

# 비밀번호 해시 (argon2id)
# 생성: node scripts/hash-password.mjs <your-password>
APP_PASSWORD_HASH=

# 세션 암호화 키 (최소 32자 이상의 hex)
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# SQLite 파일 경로 (없으면 ./data/binder.sqlite 사용)
# ⚠️ 개발(npm run dev) 시에는 프로젝트 밖 절대경로 권장.
#   WAL 모드 SQLite 가 ./data/*.sqlite-wal/-shm 을 자주 갱신 → Turbopack 이
#   코드 변경으로 오인하고 무한 재컴파일하는 이슈가 있음.
#   예) DB_PATH=C:/Users/me/binder-data/binder.sqlite
# Docker/프로덕션은 ./data 그대로 OK (파일 watcher 가 없으므로).
DB_PATH=./data/binder.sqlite

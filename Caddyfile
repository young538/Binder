(common_headers) {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output file /data/access.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}

young538.synology.me {
	reverse_proxy app:3000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	import common_headers
}

young538.iptime.org {
	# iptime.org 의 CAA 레코드가 모든 공인 CA 발급을 차단(0 issue ";").
	# 따라서 Let's Encrypt 로 인증서 발급 불가 → Caddy 자체 CA 로 self-signed 발급.
	# 모바일에서는 자체 서명 인증서를 기본 신뢰하지 않으므로 young538.synology.me 사용 권장.
	tls internal
	reverse_proxy app:3000

	import common_headers
}
